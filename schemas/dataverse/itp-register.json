{
  "$schema": "https://example.org/eka/dataverse-table.schema.json",
  "description": "Declarative, tenant-neutral Dataverse table design for the ITP register. Holds the structured header + line items of a generated Inspection and Test Plan (unsuited to a SharePoint document library). The ITP document (content type ITP) references a header row via ItpRegisterId. All generated ITPs are DRAFT pending engineering review.",
  "version": "0.1.0",
  "status": "Draft",
  "tables": [
    {
      "logicalName": "eka_itpregister",
      "displayName": "ITP Register",
      "displayCollectionName": "ITP Registers",
      "description": "Header row for one generated ITP.",
      "primaryColumn": "eka_name",
      "ownershipType": "UserOwned",
      "columns": [
        { "logicalName": "eka_name", "displayName": "ITP Title", "type": "Text", "maxLength": 255, "required": true, "description": "ITP title (primary column)." },
        { "logicalName": "eka_project", "displayName": "Project", "type": "Text", "maxLength": 100, "required": true, "description": "Project identifier." },
        { "logicalName": "eka_assettype", "displayName": "Asset Type", "type": "Choice", "required": true, "choices": ["Transmission", "Distribution", "Not asset-specific"], "description": "Keeps AS2885 (transmission) and AS4645 (distribution) distinct." },
        { "logicalName": "eka_capability", "displayName": "Capability", "type": "Choice", "required": false, "choices": ["itp"], "description": "Capability shorthand (fixed to itp)." },
        { "logicalName": "eka_scopeofwork", "displayName": "Scope of Work", "type": "Memo", "required": false, "description": "Scope the ITP covers." },
        { "logicalName": "eka_status", "displayName": "Status", "type": "Choice", "required": true, "choices": ["Draft", "In Review", "Approved", "Superseded"], "defaultValue": "Draft", "description": "Review lifecycle; defaults to Draft." },
        { "logicalName": "eka_draftmarker", "displayName": "Draft Marker", "type": "Text", "maxLength": 100, "required": true, "defaultValue": "DRAFT — pending engineering review", "description": "Carries the DRAFT marker until signed off." },
        { "logicalName": "eka_sharepointdocurl", "displayName": "SharePoint Document URL", "type": "Url", "required": false, "description": "Link to the ITP document in the GeneratedDeliverables library." },
        { "logicalName": "eka_reviewedby", "displayName": "Reviewed By", "type": "Lookup", "targetTable": "systemuser", "required": false, "description": "Qualified engineer who signed off." }
      ]
    },
    {
      "logicalName": "eka_itplineitem",
      "displayName": "ITP Line Item",
      "displayCollectionName": "ITP Line Items",
      "description": "A single inspection/test line item belonging to an ITP register header.",
      "primaryColumn": "eka_name",
      "ownershipType": "UserOwned",
      "columns": [
        { "logicalName": "eka_name", "displayName": "Activity", "type": "Text", "maxLength": 255, "required": true, "description": "Inspection or test activity (primary column)." },
        { "logicalName": "eka_itpregisterid", "displayName": "ITP Register", "type": "Lookup", "targetTable": "eka_itpregister", "required": true, "description": "Parent ITP header (many line items to one header)." },
        { "logicalName": "eka_sequence", "displayName": "Sequence", "type": "WholeNumber", "required": false, "description": "Ordering of the activity in the plan." },
        { "logicalName": "eka_acceptancecriteria", "displayName": "Acceptance Criteria", "type": "Memo", "required": false, "defaultValue": "[PLACEHOLDER - to be filled from licensed <standard> <clause> rev <year>]", "description": "Acceptance criteria. Populated ONLY from a licensed/approved source; never fabricated. Defaults to a marked placeholder." },
        { "logicalName": "eka_referencedocument", "displayName": "Reference Document", "type": "Text", "maxLength": 255, "required": false, "description": "Governing document / clause reference label (label only; no fabricated clause numbers)." },
        { "logicalName": "eka_inspectiontype", "displayName": "Inspection Type", "type": "Choice", "required": false, "choices": ["Hold Point", "Witness Point", "Surveillance", "Review", "Monitor"], "description": "Standard ITP inspection point classification." },
        { "logicalName": "eka_responsibleparty", "displayName": "Responsible Party", "type": "Text", "maxLength": 100, "required": false, "description": "Who performs/verifies the activity." },
        { "logicalName": "eka_recordrequired", "displayName": "Record Required", "type": "Text", "maxLength": 255, "required": false, "description": "Verifying record / document produced." }
      ]
    }
  ],
  "relationships": [
    {
      "name": "eka_itpregister_itplineitem",
      "type": "OneToMany",
      "referencedTable": "eka_itpregister",
      "referencingTable": "eka_itplineitem",
      "referencingColumn": "eka_itpregisterid",
      "cascadeDelete": "Cascade",
      "description": "One ITP header owns many line items."
    }
  ]
}
